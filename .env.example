# neatlogs SDK ingest key (tracing + MCP). Named differently from NEATLOGS_API_KEY on purpose:
# the CLI treats NEATLOGS_API_KEY as a legacy token fallback and errors if it differs from NEATLOGS_TOKEN.
NEATLOGS_INGEST_KEY=
# neatlogs service-account token (public REST API)
NEATLOGS_TOKEN=
NEATLOGS_HOST=https://app.neatlogs.com
NEATLOGS_PROJECT_ID=412368e1-1b3f-4fe3-9787-e7416f712084

# Hackathon LiteLLM key ($20 shared, hard stop)
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1

# Bedrock (own account 791725739974). Bearer key is for the OpenAI-compatible endpoint; Converse uses the AWS profile.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_OPENAI_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1
NEATLOGS_DETECTION_GROUP_ID=
NEATLOGS_TRACE_URL=https://app.neatlogs.com/traces/{trace_id}
OPENCODE_EXE=C:\Users\abhii\AppData\Roaming\npm\node_modules\opencode-ai\node_modules\opencode-windows-x64\bin\opencode.exe
