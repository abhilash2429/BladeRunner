{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "deny",
      "policy/*.yaml": "allow",
      "arena/guardrails/*": "allow",
      "policy/catalog.yaml": "deny"
    },
    "read": {
      "arena/scenarios/*": "deny",
      "arena/mocks/*": "deny",
      "arena/content.py": "deny",
      "arena/truth*": "deny",
      "bench/*": "deny"
    },
    "bash": {
      "*": "deny",
      "uv run pytest *": "allow"
    }
  },
  "mcp": {
    "entire-brain": {
      "type": "local",
      "command": ["entire", "brain", "mcp"],
      "enabled": true
    }
  }
}
