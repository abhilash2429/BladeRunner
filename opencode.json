{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "deny",
      "policy/*.yaml": "allow",
      "arena/guardrails/*": "allow",
      "policy/catalog.yaml": "deny"
    },
    "read": {
      "arena/scenarios/*": "deny",
      "arena/mocks/*": "deny",
      "arena/content.py": "deny",
      "arena/truth*": "deny",
      "bench/*": "deny",
      "docs/superpowers/*": "deny",
      "runs/raw/*": "deny",
      "runs/confirm_logs/*": "deny",
      ".env*": "deny",
      "*.duckdb": "deny"
    },
    "bash": {
      "*": "deny",
      "uv run pytest tests/guardrails*": "allow",
      "uv run --frozen pytest tests/guardrails*": "allow"
    },
    "webfetch": "deny",
    "external_directory": "deny"
  },
  "mcp": {
    "entire-brain": {
      "type": "local",
      "command": ["entire", "brain", "mcp"],
      "enabled": true
    }
  }
}
